<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="TallerMecanico.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Taller Mecánico Pacheco</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" href="Default.aspx">🔧 Taller Mecánico Pacheco</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item"><a class="nav-link" href="Default.aspx">Inicio / Taller</a></li>
                        <li class="nav-item"><a class="nav-link" href="Ordenes.aspx">Órdenes de Trabajo</a></li>
                        <li class="nav-item"><a class="nav-link" href="Inventario.aspx">Repuestos y Stock</a></li>
                        <li class="nav-item"><a class="nav-link" href="HistorialVehiculo.aspx">Historial por Patente</a></li>
                        <li class="nav-item"><a class="nav-link" href="Clientes.aspx">Clientes</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container flex-grow-1 pb-5">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
            © 2026 Taller Mecánico Pacheco - Sistema de Gestión Integral
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>